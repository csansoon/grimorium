{
  "name": "grimorium",
  "private": true,
  "version": "0.1.0",
  "description": "A companion app for Blood on the Clocktower that handles the clockwork so you can focus on the story.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "tc": "tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:contracts": "node ./node_modules/vitest/vitest.mjs run src/lib/__tests__/roleContracts.test.ts",
    "test:scenarios": "node ./node_modules/vitest/vitest.mjs run src/lib/__tests__/certification.test.ts",
    "test:invariants": "node ./node_modules/vitest/vitest.mjs run src/lib/__tests__/invariants.test.ts",
    "test:matrix:smoke": "node ./node_modules/vitest/vitest.mjs run src/lib/__tests__/interactionMatrix.fast.test.ts",
    "test:matrix": "node ./node_modules/vitest/vitest.mjs run src/lib/__tests__/interactionMatrix.full.test.ts src/lib/__tests__/certification.test.ts",
    "test:fast": "node ./node_modules/vitest/vitest.mjs run --exclude src/lib/__tests__/interactionMatrix.full.test.ts --exclude src/lib/__tests__/certification.test.ts",
    "test:certify": "npm run test:matrix && npm run test:invariants"
  },
  "dependencies": {
    "@lucide/lab": "^0.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@use-gesture/react": "^10.3.1",
    "@vitest/utils": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.1.2"
  }
}
